{
	"name": "aequery",
	"version": "0.7.1",
	"description": "General purpose after effects scripting library",
	"main": "dist/aequery.js",
	"type": "module",
	"scripts": {
		"test": "eslint lib/ test/",
		"lint-fix": "eslint --fix lib test",
		"build:docs": "node scripts/docs.ts",
		"build:parser": "node --experimental-import-text scripts/parser.ts"
	},
	"files": [
		"lib/*",
		"grammar/*",
		"dist/*"
	],
	"repository": {
		"type": "git",
		"url": "github:aenhancers/aequery"
	},
	"issues": "https://github.com/aenhancers/aequery/issues",
	"author": "Aenhancers",
	"license": "MIT",
	"devDependencies": {
		"docdash": "^0.4.0",
		"eslint": "^7.19.0",
		"eslint-config-aftereffects": "^1.1.0",
		"eslint-config-runegan": "^1.2.0",
		"jsdoc": "^3.6.6",
		"pegjs": "^0.10.0",
		"prettier": "^3.9.10"
	}
}
