{
	"name": "aequery",
	"version": "0.7.1",
	"description": "General purpose after effects scripting library",
	"type": "module",
	"license": "MIT",
	"issues": "https://github.com/docsforadobe/aequery/issues",
	"scripts": {
		"test": "eslint lib test",
		"lint-fix": "eslint --fix lib test",
		"build:docs": "node scripts/docs.ts",
		"build:parser": "node --experimental-import-text scripts/parser.ts"
	},
	"files": [
		"lib/*",
		"grammar/*",
		"dist/*"
	],
	"exports": {
		".": "./lib/main.js",
		"./*": "./lib/*.js"
	},
	"repository": {
		"type": "git",
		"url": "github:docsforadobe/aequery"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"docdash": "^0.4.0",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"jsdoc": "^3.6.6",
		"pegjs": "^0.10.0",
		"prettier": "^3.9.10"
	}
}
